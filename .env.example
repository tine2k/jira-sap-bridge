# ---------------------------------------------------------------------------
# SAP S/4HANA Cloud connection
# ---------------------------------------------------------------------------
# Base URL of your tenant (no trailing slash)
S4_HOST=https://my402663.s4hana.cloud.sap

# Authentication: "basic" (communication user), "oauth2" (client credentials) or
# "session" (reuse a browser session — no communication arrangement needed, see README §9)
S4_AUTH=basic

# --- basic auth (communication user created in "Maintain Communication Users")
S4_USER=
S4_PASSWORD=

# --- oauth2 client credentials (if your communication arrangement uses OAuth 2.0)
S4_CLIENT_ID=
S4_CLIENT_SECRET=
# Optional, defaults to $S4_HOST/sap/bc/sec/oauth2/token
# S4_TOKEN_PATH=/sap/bc/sec/oauth2/token

# --- session auth (S4_AUTH=session): paste the Cookie header from your browser's dev tools.
#     Example: SAP_SESSIONID_MY4_100=abc...; sap-usercontext=sap-client=100; ...
#     Expires when your browser session ends — refresh it when you get a 401.
# S4_SESSION_COOKIE=
# Optional: a CSRF token captured from a browser request (normally fetched automatically)
# S4_CSRF_TOKEN=

# API version: auto | v4 | v2
# "auto" probes both and uses whichever is active on your tenant.
S4_API_VERSION=auto

# Optional: override the service root if SAP changes it
# S4_SERVICE_PATH=/sap/opu/odata4/sap/api_manage_workforce_timesheet/srvd_a2x/sap/workforcetimesheet/0001

# ---------------------------------------------------------------------------
# Your employee / defaults
# ---------------------------------------------------------------------------
# PersonWorkAgreementExternalID — the "Employee ID" used by the timesheet API.
# Tip: run `npm run timesheet -- list --from 2026-11-01 --to 2026-11-30 --json`
# and copy the value from one of your existing entries.
EMPLOYEE_ID=

# Company code the time is recorded for (e.g. 1010)
COMPANY_CODE=

# Controlling area (e.g. A000) — required for some setups
CONTROLLING_AREA=A000

# Defaults applied when a CSV row leaves the column empty
DEFAULT_TASK_TYPE=WORK
DEFAULT_TASK_LEVEL=NONE
DEFAULT_TASK_COMPONENT=WORK
HOURS_UNIT=H

# Network timeout in milliseconds
TIMEOUT_MS=30000
