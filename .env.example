# ---------------------------------------------------------------------------
# SAP S/4HANA Cloud connection
# ---------------------------------------------------------------------------
# Base URL of your tenant (no trailing slash)
S4_HOST=https://my402663.s4hana.cloud.sap

# Authentication: a Chromium window opens for the tenant's SSO/MFA login.
# The profile keeps the IdP session between runs.
# SAP_BROWSER_PROFILE=.sap-browser-profile
# SAP_BROWSER_LOGIN_TIMEOUT_MS=300000

# Optional service override (defaults to the Fiori time sheet service)
# S4_SERVICE_PATH=/sap/opu/odata/sap/HCM_CATS_MANAG_V1/

# Network timeout in milliseconds
TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Employee and entry defaults
# ---------------------------------------------------------------------------
# Pernr — the SAP personnel number.
EMPLOYEE_ID=

# Values used by `add` and as the default day for `read`.
ENTRY_DATE=2026-11-02
ENTRY_HOURS=1.0
ENTRY_PROFILE=S4H_EXT
ENTRY_NOTE=openspec entry

# Accounting assignment sent with the entry (PO / WBS / project).
ENTRY_EXTRA_DATA_FIELDS={"SEBELP":"00035","SEBELN":"4500000216","RPROJ":"00026297","POSID":"AT0110012000001.1.10"}
